<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Deliberately permissive: this fixture contains planted issues and must
         still compile so the Roslyn analyzers have something to run against. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0162;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required by the planted SQL injection fixture. -->
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
  </ItemGroup>

</Project>
